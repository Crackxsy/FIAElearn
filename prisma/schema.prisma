// FIAElearn – Datenmodell
// Lokal läuft SQLite. Für PostgreSQL erzeugt `npm run db:postgres`
// eine Kopie dieses Schemas mit provider = "postgresql".
// Listen/Strukturen werden als Json gespeichert, damit das Schema
// auf beiden Datenbanken identisch funktioniert.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// ───────────────────────── Accounts ─────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions      Session[]
  profile       StudyProfile?
  masteries     TopicMastery[]
  attempts      Attempt[]
  reviewItems   ReviewItem[]
  studySessions StudySession[]
  simulations   ExamSimulation[]
  activity      DailyActivity[]
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  userAgent String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model RateLimit {
  key     String   @id
  count   Int
  resetAt DateTime
}

// ───────────────────────── Lernprofil ─────────────────────────

model StudyProfile {
  id     String @id @default(cuid())
  userId String @unique

  /// "AP1" | "AP2"
  phase         String
  trainingStart DateTime?
  studyStart    DateTime
  ap1Date       DateTime?
  ap2Date       DateTime?
  /// Wunschnote 1–4
  targetGrade   Int      @default(3)
  /// "DAILY" | "EVERY_2" | "EVERY_3" | "WEEKLY"
  rhythm            String @default("DAILY")
  minutesPerSession Int    @default(45)
  /// Bevorzugte Wochentage für WEEKLY, z. B. [6] (0 = Sonntag)
  weekdays          Json?
  rescueMode        Boolean  @default(false)
  placementDone     Boolean  @default(false)
  placementScore    Float?
  onboardingDone    Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ───────────────────────── Inhalte ─────────────────────────

model ExamPart {
  id            String @id
  name          String
  short         String
  durationMin   Int?
  weightPercent Int
  paragraph     String
  description   String
  order         Int

  topics      Topic[]
  simulations ExamSimulation[]
}

model LearningField {
  id          String @id
  title       String
  description String
  examHint    String
  order       Int

  topics Topic[]
}

model Source {
  id        String @id
  name      String
  url       String
  owner     String?
  priority  String
  /// "Offizielle Prüfungsregel" | "Offizieller Lehrplan" | "Lernmaterial"
  label     String
  appliesTo String
  use       String
  access    String
}

model Topic {
  id              String  @id
  examPartId      String
  learningFieldId String?
  title           String
  summary         String
  /// Prüfungsrelevanz 1–5
  weight          Int
  /// Geschätzte Lernzeit (Stunden) von 0 auf "sicher"
  baseHours       Float
  difficulty      Int
  /// Pflichtthema im Rettungsmodus
  mustKnow        Boolean @default(false)
  order           Int

  examPart      ExamPart       @relation(fields: [examPartId], references: [id])
  learningField LearningField? @relation(fields: [learningFieldId], references: [id])
  lesson        Lesson?
  questions     Question[]
  flashcards    Flashcard[]
  masteries     TopicMastery[]

  @@index([examPartId])
}

model Lesson {
  id        String @id @default(cuid())
  topicId   String @unique
  /// Markdown-ähnlicher Text (eigene Zusammenfassung)
  content   String
  keyPoints Json
  sourceIds Json

  topic Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)
}

model Question {
  id               String  @id
  topicId          String
  /// single | multiple | short | calculation | code_tracing | sql
  type             String
  difficulty       Int
  scenario         String?
  prompt           String
  code             String?
  codeLang         String?
  /// [{ id, text }]
  options          Json?
  /// Je nach Typ: { correct: [...] } | { accepted: [...] } | { value, tolerance, unit }
  answer           Json
  explanation      String
  solutionSteps    Json?
  commonMistakes   Json?
  estimatedMinutes Float   @default(1)
  points           Int     @default(1)
  sourceIds        Json
  /// Für den Einstufungstest geeignet
  placement        Boolean @default(false)
  reviewStatus     String  @default("eigene Übung – geprüft")

  topic    Topic     @relation(fields: [topicId], references: [id], onDelete: Cascade)
  attempts Attempt[]

  @@index([topicId])
}

model Flashcard {
  id       String  @id
  topicId  String
  front    String
  back     String
  mustKnow Boolean @default(false)

  topic Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@index([topicId])
}

// ───────────────────────── Fortschritt ─────────────────────────

model TopicMastery {
  id             String    @id @default(cuid())
  userId         String
  topicId        String
  /// Selbsteinschätzung 0 (nie gehört) – 3 (sicher)
  selfRating     Int?
  placementScore Float?
  /// 0..1
  mastery        Float     @default(0)
  attempts       Int       @default(0)
  correct        Int       @default(0)
  lastPracticed  DateTime?
  updatedAt      DateTime  @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([userId, topicId])
}

model ReviewItem {
  id         String   @id @default(cuid())
  userId     String
  /// "question" | "flashcard"
  itemType   String
  itemId     String
  topicId    String
  box        Int      @default(1)
  dueAt      DateTime
  lastResult Boolean?
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, itemType, itemId])
  @@index([userId, dueAt])
}

model Attempt {
  id         String   @id @default(cuid())
  userId     String
  questionId String
  topicId    String
  correct    Boolean
  /// 0..1 (Teilpunkte)
  score      Float
  answer     Json
  durationMs Int?
  /// placement | quiz | review | simulation | rescue
  context    String
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, topicId])
}

model StudySession {
  id          String    @id @default(cuid())
  userId      String
  date        DateTime
  minutes     Int
  /// learn | review | simulation | rescue | buffer
  kind        String
  examPartId  String?
  topicIds    Json
  title       String
  /// planned | done | skipped
  status      String    @default("planned")
  completedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
}

model ExamSimulation {
  id          String    @id @default(cuid())
  userId      String
  examPartId  String
  startedAt   DateTime  @default(now())
  endsAt      DateTime
  finishedAt  DateTime?
  questionIds Json
  answers     Json?
  scorePct    Float?
  grade       Int?

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  examPart ExamPart @relation(fields: [examPartId], references: [id])

  @@index([userId])
}

model DailyActivity {
  id        String @id @default(cuid())
  userId    String
  /// YYYY-MM-DD (Europe/Berlin)
  day       String
  minutes   Float  @default(0)
  questions Int    @default(0)
  correct   Int    @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, day])
}
